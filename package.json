{
  "name": "paste-without-line-breaks",
  "productName": "Unwrap",
  "version": "2.0.0",
  "description": "It converts text in clipboard to plain text without line breaks for Windows and OSX so that text translators such as google translate can better translate the texts.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:native": "node scripts/build-native.js",
    "dist": "npm run build:native && electron-builder --mac",
    "build:icons": "python3 scripts/draw-icons.py && sh scripts/build-icons.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uygardev/paste-without-line-breaks.git"
  },
  "keywords": [
    "paste",
    "plain",
    "text",
    "line",
    "breaks"
  ],
  "author": "Uygar Aydin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/uygardev/paste-without-line-breaks/issues"
  },
  "homepage": "https://github.com/uygardev/paste-without-line-breaks#readme",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "node-gyp": "^12.4.0"
  },
  "build": {
    "appId": "com.uygaraydin.paste-without-line-breaks",
    "productName": "Unwrap",
    "copyright": "Copyright © 2022-2026 Uygar Aydin",
    "files": [
      "main.js",
      "clean.js",
      "deepl.js",
      "index.html",
      "style.css",
      "icon.png",
      "assets/trayTemplate*.png",
      "native/index.js",
      "native/macos_services.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/Unwrap.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSServices": [
          {
            "NSMenuItem": {
              "default": "Copy without Line Breaks"
            },
            "NSMessage": "handleService",
            "NSPortName": "PasteWithoutLineBreaks",
            "NSSendTypes": [
              "NSStringPboardType"
            ],
            "NSUserData": "copy",
            "NSRequiredContext": {},
            "NSKeyEquivalent": {
              "default": "C"
            }
          },
          {
            "NSMenuItem": {
              "default": "Translate with DeepL without Line Breaks"
            },
            "NSMessage": "handleService",
            "NSPortName": "PasteWithoutLineBreaks",
            "NSSendTypes": [
              "NSStringPboardType"
            ],
            "NSUserData": "deepl",
            "NSRequiredContext": {},
            "NSKeyEquivalent": {
              "default": "X"
            }
          }
        ]
      }
    },
    "dmg": {
      "title": "Unwrap",
      "artifactName": "Unwrap-${version}.dmg"
    },
    "asarUnpack": [
      "native/*.node"
    ]
  }
}
